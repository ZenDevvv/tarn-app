# ---- Frontend (public config only) ----
# Only VITE_-prefixed variables reach the browser bundle.
# Never put a secret in this file's VITE_ entries. See architecture §56.
VITE_API_URL=http://localhost:4000/api/v1

# ---- Backend ----
NODE_ENV=development
PORT=4000

# PostgreSQL (matches the docker-compose service)
DATABASE_URL=postgresql://tarn:tarn@localhost:5432/tarn?schema=public

# Auth — replace with real values outside local development.
JWT_SECRET=
COOKIE_SECRET=

# Comma-separated list of allowed browser origins (CORS).
WEB_ORIGIN=http://localhost:5173

# Object storage — Phase 2 only (Resume / CoverLetter). Not required for MVP.
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# AI provider — Phase 3 only. Not required for MVP.
AI_API_KEY=