# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Test output
coverage/
playwright-report/
test-results/

# Playwright session state written by tests/e2e/global-setup.ts.
# Contains live session cookies — never commit these.
tests/e2e/.auth/

# Environment — never commit real secrets (architecture §55)
.env
.env.local
.env.*.local
!.env.example

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# WWG
# .wwg/ is intentionally committed: it is the project's governed truth.
# Exception: WWG writes timestamped config backups on every registry change.
# Those are transient working copies, not evidence, so they stay untracked.
.wwg/reports/backups/