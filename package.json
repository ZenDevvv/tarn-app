{
  "name": "tarn",
  "version": "0.0.0",
  "private": true,
  "description": "Tarn — a personal job-search tracker. Modular monolith monorepo.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @tarn/database generate",
    "db:migrate": "pnpm --filter @tarn/database migrate",
    "db:deploy": "pnpm --filter @tarn/database deploy",
    "db:seed": "pnpm --filter @tarn/database seed",
    "db:studio": "pnpm --filter @tarn/database studio",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\""
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}